---
import type { Diagram } from '../../../lib/diagram-schema';
import { inline } from '../study';
import Blocks from './Blocks.astro';
import LayerStack from './LayerStack.astro';
import Matrix from './Matrix.astro';
import NumberLine from './NumberLine.astro';
import Timeline from './Timeline.astro';
import '../../../styles/diagrams.css';

interface Props {
  diagram: Diagram;
}

// The figure shell from the diagram spec: the caption first, so a reader knows what to look for,
// then the description, which says what the drawing's own text leaves to the eye, then the drawing.
const { diagram } = Astro.props;
const captionId = `dg-${diagram.id}`;
const titleId = `${captionId}-title`;
const description = [diagram.description ?? []].flat();

// One component per kind. A kind the schema adds without a row here fails the type check, and data
// that reaches this page with an unknown kind fails the build instead of drawing an empty figure.
const components = {
  'layer-stack': LayerStack,
  matrix: Matrix,
  'number-line': NumberLine,
  timeline: Timeline,
  blocks: Blocks,
} satisfies Record<Diagram['type'], unknown>;
type Kind = (props: { diagram: Diagram; idPrefix: string; titleId: string }) => unknown;
const Kind = (components as Partial<Record<string, Kind>>)[diagram.type];
if (!Kind) throw new Error(`Diagram "${diagram.id}" is a ${String(diagram.type)}, which has no component in Diagram.astro`);
---
<figure data-diagram={diagram.type} data-card>
  <figcaption class="dg-caption" id={captionId}>
    <span class="dg-title" id={titleId} set:html={inline(diagram.title)} />
    {diagram.note && <span class="dg-note" set:html={` ${inline(diagram.note)}`} />}
  </figcaption>
  {description.map((text) => <p class="visually-hidden" set:html={inline(text)} />)}
  <Kind diagram={diagram} idPrefix={captionId} titleId={titleId} />
</figure>
