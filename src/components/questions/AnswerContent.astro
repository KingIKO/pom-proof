---
import type { CollectionEntry } from 'astro:content';
import CodeExamples from './CodeExamples.astro';

interface Props {
  answer: CollectionEntry<'questions'>['data'];
  recall?: boolean;
  cardId?: string;
  cardTitleId?: string;
}

const { answer, recall, cardId, cardTitleId } = Astro.props;
const sources = answer.sources ?? [];
const Heading = recall ? 'h2' : 'h3';
const trapHeadingId = cardId ? `question-trap:${cardId}` : 'question-trap';
const body = await Astro.slots.render('default');
const anchors = new Map<string, string>();
const inlineBody = cardId ? body.replace(/(<h[1-6]\b[^>]*?\sid=")([^"]+)"/g, (_, start: string, id: string) => {
  const anchor = `answer:${cardId}:${id}`;
  anchors.set(id, anchor);
  return `${start}${anchor}"`;
}).replace(/(\shref="#)([^"]+)"/g, (match, start: string, id: string) =>
  anchors.has(id) ? `${start}${anchors.get(id)}"` : match) : body;
---

<div class="question-answer-copy">
  <p class="question-answer-lead" data-question-search><strong>{answer.oneLine}</strong></p>
  {recall && <h2 class="visually-hidden">Full answer</h2>}
  <div class="question-answer-body" data-question-search><Fragment set:html={inlineBody} /></div>
</div>
{answer.examples && <CodeExamples examples={answer.examples} questionTitle={cardId ? answer.title : undefined} />}
<div class="question-evidence">
  <section class="question-answer-section">
    <Heading class="section-label">What they look for</Heading>
    <ul class="question-look-list" data-question-search>
      {answer.looksFor.map((item) => <li>{item}</li>)}
    </ul>
  </section>
  <section class="question-answer-section">
    <Heading class="section-label">They'll ask next</Heading>
    {answer.followUps.map(({ question, answer: followUpAnswer }) => (
      <details class="question-follow-up" name={recall ? 'question-follow-ups' : undefined}>
        <summary><span data-question-search>{question}</span><span class="chevron" aria-hidden="true"></span></summary>
        <p class="callout" data-card data-question-search>{followUpAnswer}</p>
      </details>
    ))}
  </section>
</div>
<aside class="callout trap" data-card aria-labelledby={[trapHeadingId, cardTitleId].filter(Boolean).join(' ')}>
  <Heading class="section-label" id={trapHeadingId}>The trap</Heading>
  <p data-question-search>{answer.trap}</p>
</aside>
{sources.length > 0 && (
  <p class="question-sources">
    <span>{sources.length === 1 ? 'Source' : 'Sources'}</span>
    {sources.map(({ label, url }) => <a href={url}>{label}</a>)}
  </p>
)}
