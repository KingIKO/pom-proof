---
import type { CollectionEntry } from 'astro:content';
import { questionLevels, questionTopics, questionUrl } from './questions';

interface Props {
  entry: CollectionEntry<'questions'>;
  number: number;
}

const { entry, number } = Astro.props;
const { id, data } = entry;
const slug = id.split('/')[1];
const titleId = `question-title:${slug}`;
---

<li data-question-id={id} data-topic={data.topic} data-role={data.roles.join(' ')}
  data-level={data.level} data-type={data.type}>
  <details class="question-card" id={slug} data-card>
    <summary class="question-head">
      <span class="question-number num" data-chip aria-hidden="true">{String(number).padStart(2, '0')}</span>
      <h2 id={titleId} data-question-search>{data.title}</h2>
      <span class="question-meta">
        <span class="chip" data-chip data-question-search>{questionTopics[data.topic]}</span>
        <span class="chip question-level" data-chip>{questionLevels[data.level]}</span>
      </span>
      <span class="question-status status-chip num" data-review-state>New</span>
      <span class="plus-minus" data-chip aria-hidden="true"></span>
    </summary>
    <div class="question-answer" data-question-content hidden></div>
    <noscript>
      <div class="question-answer">
        <p class="question-answer-lead"><strong>{data.oneLine}</strong></p>
        <div class="question-answer-actions">
          <div class="question-answer-links"><a class="button quiet" href={questionUrl(id)}>Open page</a></div>
        </div>
      </div>
    </noscript>
  </details>
</li>
