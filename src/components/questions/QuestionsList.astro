---
import type { CollectionEntry } from 'astro:content';
import QuestionCard from './QuestionCard.astro';
import { questionLevels, questionListUrl, questionTopics, questionTypes, withParams } from './questions';

interface Props {
  questions: CollectionEntry<'questions'>[];
}

const { questions } = Astro.props;
const searchLabel = `Search ${questions.length} questions`;
const selects = [
  { name: 'level', label: 'Level', options: questionLevels, all: 'All levels' },
  { name: 'type', label: 'Type', options: questionTypes, all: 'All types' },
];
const topics = Object.entries(questionTopics).map(([id, label]) => ({
  id,
  label,
  count: questions.filter(({ data }) => data.topic === id).length,
}));
---

<div class="questions-layout" data-question-bank>
  <nav class="topic-rail" aria-label="Question topics" data-bank-control hidden>
    <h2 class="section-label">Topics</h2>
    <ul class="topic-links" role="list">
      {topics.map(({ id, label, count }) => (
        <li>
          <a href={withParams(questionListUrl, new URLSearchParams({ topic: id }))} data-topic-filter={id} data-chip>
            <span>{label}</span><span class="count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <section class="question-results" aria-label="Question list">
    <div class="question-toolbar filter-bar" id="review" data-card data-bank-control hidden>
      <form class="question-filter" role="search" aria-label="Question filters" data-question-filters>
        <label class="visually-hidden" for="question-q">{searchLabel}</label>
        <input class="input" id="question-q" type="search" name="q" placeholder={searchLabel} />
        {selects.map(({ name, label, options, all }) => (
          <div class="select-field">
            <label class="visually-hidden" for={`question-${name}`}>{label}</label>
            <select class="input" id={`question-${name}`} name={name}>
              <option value="">{all}</option>
              {Object.entries(options).map(([id, text]) => <option value={id}>{text}</option>)}
            </select>
            <span class="chevron" aria-hidden="true"></span>
          </div>
        ))}
      </form>
      <div class="question-toolbar-actions">
        <span class="question-visible-count num" role="status" data-question-count>{questions.length} shown</span>
        <button class="button outline question-review-button" type="button" data-question-review>Review due questions</button>
      </div>
    </div>
    <div class="empty-state" data-card data-question-empty hidden>
      <div>No matching questions</div>
      <a class="button outline" href={questionListUrl} data-question-reset>Clear filters</a>
    </div>
    <ol class="question-list" role="list" aria-label="Questions">
      {questions.map((entry, index) => <QuestionCard entry={entry} number={index + 1} />)}
    </ol>
  </section>
</div>

<script>
  import { setupQuestionBank } from './question-bank';

  const bank = document.querySelector<HTMLElement>('[data-question-bank]');
  if (bank) setupQuestionBank(bank);
</script>
