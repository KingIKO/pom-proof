---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProgressDashboard from '../../components/shell/ProgressDashboard';
import TitleBand from '../../components/shell/TitleBand.astro';
import { catalogProblem, orderedProblems } from '../../lib/catalog';
import '../../styles/progress.css';

const [entries, questions] = await Promise.all([orderedProblems(), getCollection('questions')]);
const problems = entries.map(catalogProblem);
const questionIds = questions.map(({ id }) => id);
---
<Base title="Progress" section="progress" wide>
  <TitleBand slot="title-band" title="Progress" meta="Practice scores and question reviews" />
  <ProgressDashboard client:load problems={problems} questionIds={questionIds} />
</Base>
