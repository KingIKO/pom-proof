---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProblemStatement from '../../../components/shell/ProblemStatement.astro';
import TitleBand from '../../../components/shell/TitleBand.astro';
import Structured from '../../../engines/structured/index';
import { highlightMarkedCode } from '../../../engines/structured/highlight';
import Mutation from '../../../engines/mutation/index';
import Locator from '../../../engines/locator/index';
import Sql from '../../../engines/sql/index';
import Code from '../../../engines/code/index';
import type { Problem } from '../../../lib/contracts';
import { catalogProblem, orderedProblems } from '../../../lib/catalog';
import { difficultyLabel, kindLabel, roleLabel, topicLabel } from '../../../lib/labels';
import { problemUrl, url } from '../../../lib/url';
import '../../../styles/workspace.css';

export async function getStaticPaths() {
  return (await orderedProblems()).map((entry, index, problems) => ({
    params: { kind: entry.data.kind, id: entry.id.split('/').at(-1) },
    props: {
      entry,
      position: { at: index + 1, total: problems.length },
      previous: index > 0 ? catalogProblem(problems[index - 1]) : undefined,
      next: index + 1 < problems.length ? catalogProblem(problems[index + 1]) : undefined,
    },
  }));
}

const { entry, position, previous, next } = Astro.props;
const problem: Problem = { ...entry.data, id: entry.id };
const { Content } = await render(entry);
const editorial = Astro.params.id ? await getEntry('editorials', Astro.params.id) : undefined;
const Editorial = editorial ? (await render(editorial)).Content : undefined;
const markedCode = 'items' in problem ? await highlightMarkedCode(problem.items) : {};
---
<Base title={problem.title} section="practice" wide>
  <TitleBand
    slot="title-band"
    title={problem.title}
    breadcrumbs={[{ label: 'Practice', href: '/' }, { label: kindLabel[problem.kind] }]}
  >
    <div slot="meta" class="workspace-meta">
      <span class:list={['difficulty', problem.difficulty]}>{difficultyLabel[problem.difficulty]}</span>
      <span>{topicLabel(problem.topic)}</span>
      <span class="num">{problem.minutes} min</span>
      <span>{problem.roles.map((role) => roleLabel[role]).join(', ')}</span>
    </div>
    <span slot="actions" class="status-chip workspace-status" data-workspace-status={problem.id}>Unattempted</span>
  </TitleBand>
  <div class="workspace-grid">
    <ProblemStatement problemId={problem.id} editorialHref={editorial && url(`/editorials/${editorial.id}/`)}>
      <Content />
      <Fragment slot="editorial">{Editorial && <Editorial />}</Fragment>
    </ProblemStatement>
    <section aria-labelledby="workspace-heading" class="workspace">
      <h2 id="workspace-heading">Workspace</h2>
      {problem.kind === 'test-design' ? <Mutation client:load problem={problem} />
        : problem.kind === 'locator' ? <Locator client:load problem={problem} />
        : problem.kind === 'sql' ? <Sql client:load problem={problem} />
        : problem.kind === 'code' ? <Code client:load problem={problem} />
        : <Structured client:load problem={problem} markedCode={markedCode} />}
    </section>
  </div>
  {/* Built with the catalog position and neighbours; the script below follows the list the learner last filtered. */}
  <nav class="practice-neighbors" aria-label="Adjacent problems" data-practice-neighbors={problem.id}>
    <p class="practice-position" data-practice-position>All problems: {position.at} of {position.total}</p>
    <p class="previous" hidden={!previous}>
      <span class="muted">Previous</span><a href={previous && problemUrl(previous.id)} rel="prev">{previous?.title}</a>
    </p>
    <p class="next" hidden={!next}>
      <span class="muted">Next</span><a href={next && problemUrl(next.id)} rel="next">{next?.title}</a>
    </p>
    <a class="practice-return" href={url('/')}>Back to practice</a>
  </nav>
</Base>

<script>
  import { problemStatus, statusLabel } from '../../../lib/labels';
  import { bestScores, onProgressChange, readProgress } from '../../../lib/progress';

  const badge = document.querySelector<HTMLElement>('[data-workspace-status]');
  if (badge) {
    const id = badge.dataset.workspaceStatus!;
    const update = () => {
      const status = problemStatus(bestScores(readProgress().attempts).get(id));
      badge.textContent = statusLabel[status];
      badge.classList.toggle('solved', status === 'solved');
      badge.classList.toggle('attempted', status === 'attempted');
    };
    onProgressChange(update);
    window.addEventListener('pageshow', update);
    update();
  }
</script>

<script>
  import { practiceListHref, practicePlace, readPracticeContext, type Neighbour } from '../../../lib/practice-context';
  import { problemUrl, url } from '../../../lib/url';

  // Previous, Next, the position line and the way back follow the list the learner last saw on
  // Practice in this tab. Without that list, or when it does not hold this problem, the page keeps
  // what was built: catalog neighbours, its catalog position and plain links.
  const nav = document.querySelector<HTMLElement>('[data-practice-neighbors]');
  if (nav) {
    const id = nav.dataset.practiceNeighbors!;
    const position = nav.querySelector<HTMLElement>('[data-practice-position]')!;
    const back = nav.querySelector<HTMLAnchorElement>('a.practice-return')!;
    const crumb = document.querySelector<HTMLAnchorElement>(`.breadcrumb a[href="${url('/')}"]`);
    const sides = (['prev', 'next'] as const).map((rel) => {
      const link = nav.querySelector<HTMLAnchorElement>(`a[rel="${rel}"]`)!;
      const built = { hidden: link.parentElement!.hidden, href: link.getAttribute('href'), title: link.textContent };
      const show = (target: Neighbour | undefined) => {
        link.parentElement!.hidden = !target;
        if (target) link.href = problemUrl(target.id);
        else link.removeAttribute('href');
        link.textContent = target?.title ?? '';
      };
      const reset = () => {
        link.parentElement!.hidden = built.hidden;
        if (built.href) link.setAttribute('href', built.href);
        else link.removeAttribute('href');
        link.textContent = built.title;
      };
      return { show, reset };
    });
    const builtPosition = position.textContent;
    const builtBack = { href: back.getAttribute('href')!, text: back.textContent! };
    const builtCrumb = crumb?.getAttribute('href');

    const follow = () => {
      const context = readPracticeContext();
      const place = context && practicePlace(context, id);
      if (!context || !place) {
        sides.forEach(({ reset }) => reset());
        position.textContent = builtPosition;
        back.setAttribute('href', builtBack.href);
        back.textContent = builtBack.text;
        if (crumb && builtCrumb) crumb.setAttribute('href', builtCrumb);
        return;
      }
      sides[0].show(place.previous);
      sides[1].show(place.next);
      position.textContent = `${context.label || 'All problems'}: ${place.position} of ${place.total}`;
      const listHref = practiceListHref(context.query, id);
      back.href = listHref;
      back.textContent = context.label ? `Back to ${context.label}` : builtBack.text;
      if (crumb) crumb.href = listHref;
    };
    follow();
    // A page restored from the back-forward cache picks up a list changed in the meantime.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) follow();
    });
  }
</script>
