---
import { getCollection } from 'astro:content';
import QuestionsList from '../../components/questions/QuestionsList.astro';
import Base from '../../layouts/Base.astro';

const questions = (await getCollection('questions')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en') || a.id.localeCompare(b.id, 'en'));
---
<Base title="Questions" section="questions">
  <h1>Questions</h1>
  <QuestionsList questions={questions} />
</Base>
