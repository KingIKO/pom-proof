---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import QuestionAnswer from '../../../components/questions/QuestionAnswer.astro';
import { questionLevels, questionListUrl, questionTopics, questionTypes } from '../../../components/questions/questions';
import TitleBand from '../../../components/shell/TitleBand.astro';
import Base from '../../../layouts/Base.astro';
import '../../../styles/questions.css';

export async function getStaticPaths() {
  return (await getCollection('questions')).map((entry) => {
    const [topic, id] = entry.id.split('/');
    return { params: { topic, id }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'questions'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, topic, level, type } = entry.data;
---

<Base title={title} section="questions">
  <TitleBand slot="title-band" title={title} narrow
    breadcrumbs={[{ label: 'POM Proof', href: '/' }, { label: 'Questions' }]}>
    <div slot="meta" class="question-meta">
      <span class="chip" data-chip>{questionTopics[topic]}</span>
      <span class="chip question-level" data-chip>{questionLevels[level]}</span>
      <span class="chip question-level" data-chip>{questionTypes[type]}</span>
    </div>
    <a slot="actions" class="button outline" href={questionListUrl} data-questions-back>Back to questions</a>
  </TitleBand>
  <article class="question-recall">
    <QuestionAnswer id={entry.id} answer={entry.data}><Content /></QuestionAnswer>
  </article>
</Base>
