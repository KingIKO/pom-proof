---
import { TrackSections } from '../../components/tracks/TrackViews';
import TitleBand from '../../components/shell/TitleBand.astro';
import Base from '../../layouts/Base.astro';
import { orderedTracks } from '../../lib/catalog';

export async function getStaticPaths() {
  return (await orderedTracks()).map((track) => ({ params: { role: track.role }, props: { track } }));
}

const { track } = Astro.props;
---
<Base title={track.title} section="tracks">
  <TitleBand slot="title-band" title={track.title} meta={track.summary} narrow
    breadcrumbs={[{ label: 'POM Proof', href: '/' }, { label: 'Tracks', href: '/tracks/' }, { label: track.title }]} />
  <TrackSections client:load sections={track.sections} />
</Base>
