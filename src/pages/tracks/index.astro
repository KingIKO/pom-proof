---
import { TracksList } from '../../components/tracks/TrackViews';
import Base from '../../layouts/Base.astro';
import { orderedTracks } from '../../lib/catalog';

const tracks = (await orderedTracks()).map(({ id, title, summary, sections }) => ({
  id, title, summary,
  problemIds: sections.flatMap(({ problems }) => problems.map((item) => item.id)),
  questionIds: sections.flatMap(({ questions }) => questions.map((item) => item.id)),
}));
---
<Base title="Tracks" section="tracks">
  <h1>Tracks</h1>
  <p class="prose muted track-intro">Choose a role and work through its rounds in order.</p>
  <TracksList client:load tracks={tracks} />
</Base>
