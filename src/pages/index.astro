---
import Base from '../layouts/Base.astro';
import PracticeList, { PracticeCount, PracticeProgress } from '../components/shell/PracticeList';
import TitleBand from '../components/shell/TitleBand.astro';
import { catalogProblem, orderedProblems } from '../lib/catalog';
import '../styles/catalog.css';

const problems = (await orderedProblems()).map(catalogProblem);
---
<Base title="Practice" section="practice" wide>
  <TitleBand slot="title-band" title="Practice">
    <PracticeCount slot="meta" client:load total={problems.length} />
    <PracticeProgress slot="actions" client:load problems={problems.map(({ id, title }) => ({ id, title }))} />
  </TitleBand>
  <PracticeList client:load problems={problems} />
</Base>
