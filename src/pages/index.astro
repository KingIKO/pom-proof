---
import Base from '../layouts/Base.astro';
import PracticeList from '../components/shell/PracticeList';
import { catalogProblem, orderedProblems } from '../lib/catalog';
import '../styles/catalog.css';

const problems = (await orderedProblems()).map(catalogProblem);
---
<Base title="Practice" section="practice">
  <h1>Practice</h1>
  <p class="prose page-intro">Free interview practice for QA and SDET roles.</p>
  <PracticeList client:load problems={problems} />
</Base>
