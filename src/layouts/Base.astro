---
import { url } from '../lib/url';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/components.css';

interface Props {
  title: string;
  section?: 'practice' | 'study' | 'questions' | 'tracks' | 'progress';
  wide?: boolean;
}

const { title, section, wide } = Astro.props;
const nav = [
  { id: 'practice', label: 'Practice', href: url('/') },
  { id: 'study', label: 'Study', href: url('/study/') },
  { id: 'questions', label: 'Questions', href: url('/questions/') },
  { id: 'tracks', label: 'Tracks', href: url('/tracks/') },
  { id: 'progress', label: 'Progress', href: url('/progress/') },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title} | POM Proof</title>
  </head>
  <body>
    <a class="skip-link" href={url('#main')}>Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>POM Proof</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map(({ id, label, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={id === section ? (Astro.url.pathname === href ? 'page' : 'location') : undefined}
                  data-practice-home={id === 'practice' ? '' : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot name="title-band" />
      <div class:list={['container', 'page-content', { wide }]}>
        <slot />
      </div>
    </main>
  </body>
</html>

<script>
  import { practiceContextEvent, practiceListHref, readPracticeContext, type PracticeContext } from '../lib/practice-context';

  // The header Practice link reopens the list with the filters last used in this tab.
  // The brand link stays plain, so it always opens every problem.
  const home = document.querySelector<HTMLAnchorElement>('a[data-practice-home]');
  if (home) {
    const update = (context = readPracticeContext()) => {
      home.href = practiceListHref(context?.query);
    };
    update();
    window.addEventListener(practiceContextEvent, (event) => update((event as CustomEvent<PracticeContext>).detail));
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) update();
    });
  }
</script>

<style>
  .site-header {
    background: var(--ink);
    color: var(--surface);
    --focus: var(--accent);
  }
  .header-inner {
    display: flex;
    align-items: stretch;
    gap: var(--space-32);
    block-size: var(--header-height);
  }
  .brand, .site-nav a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand {
    align-self: center;
    padding-block: var(--space-8);
    color: var(--surface);
    font-size: var(--type-20);
    font-weight: var(--weight-bold);
    letter-spacing: -.025em;
  }
  .site-nav { min-inline-size: 0; }
  .site-nav ul {
    display: flex;
    gap: var(--space-8);
    block-size: 100%;
    list-style: none;
    padding: var(--space-4);
    padding-inline-start: 0;
    margin: 0;
  }
  .site-nav a {
    position: relative;
    block-size: 100%;
    padding-inline: var(--space-12);
    color: var(--onInkMuted);
    font-size: var(--type-14);
    font-weight: var(--weight-medium);
  }
  .site-nav a:is(:hover, [aria-current]) { color: var(--surface); }
  .site-nav a[aria-current]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(-1 * var(--space-4));
    block-size: 3px;
    background: var(--accent);
  }
  .page-content { --container-width: var(--read-width); padding-block: var(--space-32) var(--space-48); }
  .page-content.wide { --container-width: var(--page-width); }
  .skip-link {
    position: fixed;
    inset: var(--space-8) auto auto var(--space-8);
    z-index: 4;
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-control);
    background: var(--surface);
    outline-color: var(--accent);
  }
  .skip-link:not(:focus) { clip-path: inset(50%); }
  @media (min-width: 48rem) {
    .site-header { position: sticky; inset-block-start: 0; z-index: 3; }
    :global(html) { scroll-padding-block-start: calc(var(--header-height) + var(--space-8)); }
  }
  @media (width < 48rem) {
    .page-content { padding-block-start: var(--space-24); }
  }
  /* Five links do not fit beside the brand on a phone, so the nav takes its own row below it. The
     links spread across that row with 44px tall targets; the sideways scroll only remains as a
     fallback for screens narrower than 320px. */
  @media (width < 36rem) {
    .header-inner { flex-wrap: wrap; gap: 0; block-size: auto; }
    .brand { flex: 1 0 100%; min-block-size: 2.75rem; padding-block: 0; font-size: var(--type-16); }
    .site-nav {
      flex: 1 0 100%;
      margin-inline: calc(-1 * var(--space-4));
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-nav ul { justify-content: space-between; gap: 0; max-inline-size: 26rem; padding: 0; }
    .site-nav a { min-block-size: 2.75rem; padding-inline: var(--space-4); font-size: var(--type-13); }
    .site-nav a[aria-current]::after { inset-block-end: 0; }
  }
</style>
